@page "/"
@using System.Globalization
@using umount.Models
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>UMOUNT</PageTitle>

<div class="page">
    <div class="card">
        <section class="board">
            <div class="toolbar">
                <div class="toolbar-left">
                    <span class="brand">UMOUNT</span>
                    <div class="tabs">
                        @foreach (var (key, label) in ModeTabs)
                        {
                            <button class="@(mode == key ? "on" : null)" @onclick="() => SetMode(key)">@label</button>
                        }
                    </div>
                </div>
                <div class="filters">
                    @foreach (var (key, label) in Filters)
                    {
                        <button class="@(filter == key ? "on" : null)" @onclick="() => filter = key">@label</button>
                    }
                </div>
            </div>

            @if (mode == "map")
            {
                <div class="map" @ref="mapEl"></div>
            }
            else
            {
                <div class="stamp-wrap">
                    <div class="stamps">
                        @foreach (var m in mountains)
                        {
                            var sel = m.Id == selected?.Id;
                            var ink = sel ? "#d9622b" : InkFor(m);
                            var bg = sel ? "#fbeee4" : "#efe9dc";
                            <div class="stamp" style="opacity:@(Passes(m) ? "1" : "0.18")" @onclick="() => Pick(m.Id)">
                                <div class="seal" style="--ink:@ink;--bg:@bg;--rot:@(((m.Id * 37) % 13) - 6)deg">
                                    <span class="seal-alt">@Alt(m.Altitude)</span>
                                    <span class="seal-name">@m.Name.Replace(" - ", " ")</span>
                                    <span class="seal-date">@FirstVisit(m)</span>
                                    @if (m.VisitCount > 1)
                                    {
                                        <span class="seal-count">×@m.VisitCount</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="detail" @ref="detailEl">
            @if (selected is not null)
            {
                <div class="head">
                    <span class="no">No. @selected.Id.ToString("00") · @Alt(selected.Altitude)</span>
                    <span class="name">@selected.Name</span>
                    <span class="location">@selected.Location</span>
                </div>

                <div class="visits">
                    @foreach (var v in selected.Visits.OrderByDescending(v => v.Date))
                    {
                        var open = v == openVisit;
                        var bodyId = $"visit-{selected.Id}-{v.Date:yyyyMMdd}";
                        var steps = (v.Course ?? "").Split(" - ", StringSplitOptions.RemoveEmptyEntries);
                        var elapsed = Elapsed(v.Duration);
                        <article @key="v" class="visit @(open ? "open" : null)">
                            <button class="visit-head" aria-expanded="@(open ? "true" : "false")" aria-controls="@bodyId"
                                    @onclick="() => Toggle(v)">
                                <span class="visit-when">
                                    <span class="visit-date">@FormatDate(v.Date)</span>
                                    <span class="visit-dur">@v.Duration</span>
                                </span>
                                <span class="visit-sum">
                                    @if (v.Stats is { } st)
                                    {
                                        <span><b>@st.Distance.ToString("0.0", CultureInfo.InvariantCulture)</b> km</span>
                                        @if (st.Ascent is { } asc)
                                        {
                                            <span>↑ <b>@Num(asc)</b> m</span>
                                        }
                                    }
                                    @if (elapsed is not null)
                                    {
                                        <span><b>@elapsed</b></span>
                                    }
                                    @if (v.Stats is { } st2)
                                    {
                                        <span><b>@Num(st2.Calories)</b> kcal</span>
                                    }
                                </span>
                                <span class="chev" aria-hidden="true"></span>
                            </button>

                            @if (open)
                            {
                                <div class="visit-body" id="@bodyId" @ref="visitBodyEl">
                                    @if (HasMap(v))
                                    {
                                        <div class="map-card">
                                            <div class="map-frame">
                                                <div class="visit-map" @ref="visitMapEl"></div>
                                                <div class="map-legend">
                                                    @if (v.Track is not null)
                                                    {
                                                        <span><i class="lg-line"></i>경로</span>
                                                        <span><i class="lg-start"></i>출발</span>
                                                        @if (!IsRoundTrip(v))
                                                        {
                                                            <span><i class="lg-end"></i>도착</span>
                                                        }
                                                    }
                                                    @if (v.Parking is not null)
                                                    {
                                                        <span><i class="p-icon">P</i>주차</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (v.Track is not null)
                                            {
                                                <div class="profile" @ref="profileEl"></div>
                                            }
                                        </div>
                                    }

                                    <div class="section">
                                        <span class="section-label">코스</span>
                                        <div class="course">
                                            @for (var i = 0; i < steps.Length; i++)
                                            {
                                                <div class="step">
                                                    <div class="rail">
                                                        <span class="dot"></span>
                                                        @if (i < steps.Length - 1)
                                                        {
                                                            <span class="line"></span>
                                                        }
                                                    </div>
                                                    <span class="step-name">@steps[i]</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="section">
                                        <span class="section-label">주차</span>
                                        @if (v.Parking is { } p)
                                        {
                                            <a class="parking" href="@GoogleMaps(p)" target="_blank" rel="noopener">
                                                <i class="p-icon">P</i>
                                                <div class="parking-info">
                                                    <div class="parking-line">
                                                        <span class="parking-name">@p.Name</span>
                                                        <span class="parking-fee">@p.Fee</span>
                                                    </div>
                                                    <span class="parking-address">@p.Address</span>
                                                </div>
                                                <span class="gmaps">구글 지도 ↗</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="no-parking">기록 없음</span>
                                        }
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private static readonly (string Key, string Label)[] ModeTabs = [("stamp", "도장"), ("map", "지도")];
    // 최소 고도 기준 필터 (0 = 전체)
    private static readonly (int Key, string Label)[] Filters = [(0, "전체"), (500, "500m+"), (1000, "1,000m+"), (1500, "1,500m+")];
    private const string WeekDays = "일월화수목금토";

    private List<Mountain> mountains = new();
    private Mountain? selected;
    private Visit? openVisit;
    private string mode = "map";
    private int filter;

    private ElementReference mapEl;
    private ElementReference visitMapEl;
    private ElementReference profileEl;
    private ElementReference visitBodyEl;
    private ElementReference detailEl;
    private IJSObjectReference? module;
    private DotNetObjectReference<Home>? selfRef;
    private bool overviewReady;
    private (int, Visit?)? detailShownFor;
    private (int?, int)? lastSync;
    private bool revealPending;
    private bool revealVisitPending;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var data = await Http.GetFromJsonAsync<MountainData>("data/mountains.json");
            mountains = data?.Mountains ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }

        // 기본 선택: 가장 많이 방문한 산(동률이면 최근 방문)
        var initial = mountains
            .OrderByDescending(m => m.VisitCount)
            .ThenByDescending(m => m.Visits.Select(v => v.Date).DefaultIfEmpty().Max())
            .FirstOrDefault();
        if (initial is not null) Select(initial.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (mountains.Count == 0) return;
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dojang.js");
        selfRef ??= DotNetObjectReference.Create(this);

        if (mode == "map" && !overviewReady)
        {
            overviewReady = true;
            lastSync = (selected?.Id, filter);
            var points = mountains.Select(m => new { m.Id, m.Name, m.Altitude, m.Latitude, m.Longitude, m.VisitCount });
            await module.InvokeVoidAsync("initOverview", mapEl, points, selfRef, selected?.Id, filter);
        }
        else if (overviewReady && lastSync != (selected?.Id, filter))
        {
            lastSync = (selected?.Id, filter);
            await module.InvokeVoidAsync("syncOverview", selected?.Id, filter);
        }

        var mapVisit = openVisit is not null && HasMap(openVisit) ? openVisit : null;
        if (selected is not null && mapVisit is not null)
        {
            if (detailShownFor != (selected.Id, mapVisit))
            {
                detailShownFor = (selected.Id, mapVisit);
                await module.InvokeVoidAsync("showDetail", visitMapEl,
                    mapVisit.Track is null ? null : (object)profileEl,
                    new { selected.Name, selected.Latitude, selected.Longitude },
                    mapVisit.Parking is { } p ? new { p.Latitude, p.Longitude, href = GoogleMaps(p) } : null,
                    mapVisit.Track is null ? null : $"data/{mapVisit.Track}",
                    !IsRoundTrip(mapVisit));
            }
        }
        else if (detailShownFor is not null)
        {
            detailShownFor = null;
            await module.InvokeVoidAsync("disposeDetail");
        }

        if (revealVisitPending)
        {
            revealVisitPending = false;
            if (openVisit is not null) await module.InvokeVoidAsync("revealVisit", visitBodyEl);
        }

        if (revealPending)
        {
            revealPending = false;
            await module.InvokeVoidAsync("revealDetail", detailEl);
        }
    }

    [JSInvokable]
    public void OnMarkerClick(int id)
    {
        Pick(id);
        StateHasChanged();
    }

    private void Pick(int id)
    {
        Select(id);
        revealPending = true;
    }

    private void Select(int id)
    {
        selected = mountains.FirstOrDefault(m => m.Id == id);
        openVisit = selected?.Visits.OrderByDescending(v => v.Date).FirstOrDefault();
    }

    // 방문 카드 펼치기/접기 (한 번에 하나만 열림)
    private void Toggle(Visit v)
    {
        openVisit = openVisit == v ? null : v;
        revealVisitPending = openVisit is not null;
    }

    private static bool HasMap(Visit v) => v.Track is not null || v.Parking is not null;

    // 코스가 "원점회귀"로 끝나거나 출발지로 돌아오면 원점회귀 (GPX 시작·종료 위치는 기록 시점에 따라 달라 쓰지 않음)
    private static bool IsRoundTrip(Visit v)
    {
        var steps = (v.Course ?? "").Split(" - ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return steps.Length < 2 || steps[^1] == "원점회귀" || steps[^1] == steps[0];
    }

    private async Task SetMode(string next)
    {
        if (mode == next) return;
        mode = next;
        if (overviewReady && module is not null)
        {
            overviewReady = false;
            await module.InvokeVoidAsync("disposeOverview");
        }
    }

    private bool Passes(Mountain m) => m.Altitude >= filter;

    private static string InkFor(Mountain m) => m.Altitude >= 1000 ? "#2f5d46" : "#5b6e5e";

    private static string Alt(double altitude) =>
        Num(altitude) + "m";

    private static string Num(double value) =>
        Math.Round(value, MidpointRounding.AwayFromZero).ToString("N0", CultureInfo.InvariantCulture);

    private static string FirstVisit(Mountain m) =>
        m.Visits.Count == 0 ? "" : m.Visits.Min(v => v.Date).ToString("yy.MM.dd", CultureInfo.InvariantCulture);

    private static string FormatDate(DateTime d) =>
        $"{d.ToString("yyyy.MM.dd", CultureInfo.InvariantCulture)} ({WeekDays[(int)d.DayOfWeek]})";

    private static string? Elapsed(string? duration)
    {
        var parts = duration?.Split('~');
        if (parts is not { Length: 2 }
            || !TimeSpan.TryParse(parts[0].Trim(), CultureInfo.InvariantCulture, out var start)
            || !TimeSpan.TryParse(parts[1].Trim(), CultureInfo.InvariantCulture, out var end))
            return null;
        var minutes = (int)(end - start).TotalMinutes;
        return $"{minutes / 60}h {minutes % 60:00}m";
    }

    private static string GoogleMaps(ParkingInfo p) =>
        string.Create(CultureInfo.InvariantCulture, $"https://www.google.com/maps/search/?api=1&query={p.Latitude},{p.Longitude}");

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("disposeOverview");
                await module.InvokeVoidAsync("disposeDetail");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        selfRef?.Dispose();
    }
}
